# DSTC Matching — FastAPI backend image.
# Built and pushed to GHCR by .github/workflows/deploy-backend.yml.
#
# Build locally:
#   docker build -t dstc-matching -f server/Containerfile server/
# Run (API_PORT defaults to 36918, override via env):
#   docker run --rm -e API_PORT=36918 -p 36918:36918 --env-file server/.env dstc-matching

# ── Builder: compile C extensions (asyncpg, cryptography) ───────────────
FROM python:3.14-alpine AS builder
ENV PIP_NO_CACHE_DIR=1 \
    PYTHONUNBUFFERED=1

WORKDIR /install

# gcc + musl-dev for any package without a cp314 wheel; asyncpg has no
# libpq runtime dep so the runtime stage stays toolchain-free.
RUN apk add --no-cache gcc musl-dev

COPY requirements.txt .
# Install into a prefix we copy verbatim into the runtime image (same Python 3.14).
RUN pip install --prefix=/install -r requirements.txt

# ── Runtime: alpine, no toolchain ───────────────────────────────────────
FROM python:3.14-alpine AS runtime
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

# Installed packages from the builder stage.
COPY --from=builder /install /usr/local

# Application code (see .dockerignore for what is excluded).
COPY . .

# curl for Docker healthchecks (Alpine doesn't ship it by default).
RUN apk add --no-cache curl

ENV API_PORT=36918
EXPOSE ${API_PORT}

# uvicorn is installed into /usr/local/bin via the prefix copy above.
CMD ["sh", "-c", "uvicorn main:app --host 0.0.0.0 --port ${API_PORT}"]
